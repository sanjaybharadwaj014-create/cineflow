{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start CineFlow Server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe run.py",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Tests (pytest)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/pytest.exe -v",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
